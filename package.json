{
  "name": "nexora",
  "version": "0.5.0",
  "private": true,
  "description": "NEXORA — Meet. Connect. Discover.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f database/schema.sql -f database/migrations/002_game_world.sql -f database/migrations/003_social_game_systems.sql",
    "check": "node --check server.js && for file in src/*.js; do node --check \"$file\"; done"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  }
}
