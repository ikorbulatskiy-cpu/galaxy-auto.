{
  "name": "nexora",
  "version": "0.6.0",
  "private": true,
  "description": "NEXORA — Meet. Connect. Discover.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "db:migrate": "node scripts/migrate.js",
    "check": "node --check server.js && for file in src/*.js scripts/*.js public/*.js; do node --check \"$file\"; done",
