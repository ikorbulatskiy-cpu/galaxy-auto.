NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexora
DATABASE_SSL=false
DB_POOL_MAX=10

# Optional one-time bootstrap: promote this verified account to developer during db:migrate.
# Remove it from the environment after the account has been promoted.
NEXORA_BOOTSTRAP_ADMIN_EMAIL=

# Required for production email verification
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# S3-compatible image storage (for example, Cloudflare R2)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Set only when deployed behind a known reverse proxy.
# Example: TRUST_PROXY_HOPS=1
TRUST_PROXY_HOPS=
