    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
